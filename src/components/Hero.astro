---
import { siteConfig } from '../data/siteConfig';

const whatsappSampleUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(
  'Olá! Gostaria de pedir uma amostra grátis de 30s de edição com o estúdio MIZZY.'
)}`;

const whatsappCallUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(
  'Olá! Gostaria de agendar uma call rápida de 15 minutos para falar sobre minhas edições.'
)}`;
---

<section id="inicio" class="relative isolate overflow-hidden border-b border-border py-12 sm:py-16 lg:py-20">
  <div aria-hidden="true" class="bg-grid-pattern mask-radial-center pointer-events-none absolute inset-0 opacity-40">
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 left-1/2 size-[32rem] -translate-x-1/2 rounded-full bg-accent/20 blur-[140px]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-1/4 size-[22rem] rounded-full bg-accent-purple/15 blur-[120px]"
  >
  </div>

  <div class="container-vao relative">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="flex flex-col items-start text-left lg:col-span-7">
        <div
          class="inline-flex max-w-full items-center gap-2 rounded-lg sm:rounded-full border border-accent/40 bg-accent/10 px-3 py-1.5 shadow-[0_0_15px_rgba(99,102,241,0.2)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="shrink-0 text-accent"
          >
            <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
          </svg>
          <span class="font-mono text-[10px] sm:text-[11px] font-semibold uppercase leading-snug tracking-wider text-accent-light">
            {siteConfig.hero.eyebrow}
          </span>
        </div>
        <h1
          class="mt-5 max-w-2xl font-display text-2xl font-extrabold leading-[1.16] tracking-tight text-white sm:text-4xl lg:text-[2.65rem]"
        >
          <span>{siteConfig.hero.titleLine1} </span>
          <span class="bg-gradient-to-r from-accent via-accent-light to-accent-cyan bg-clip-text text-transparent">
            {siteConfig.hero.titleHighlight}
          </span>{' '}
          <span class="text-zinc-100">{siteConfig.hero.titleLine2}</span>
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-300 sm:text-base">
          {siteConfig.hero.description}
        </p>
        <div class="mt-7 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href={whatsappSampleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 text-sm font-semibold text-white shadow-[0_0_25px_rgba(99,102,241,0.5)] transition-all duration-200 hover:bg-accent-hover hover:scale-[1.01] hover:shadow-[0_0_35px_rgba(99,102,241,0.75)] sm:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0"
            >
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z" />
            </svg>
            <span>{siteConfig.hero.primaryCta}</span>
            <span>&rarr;</span>
          </a>

          <a
            href={whatsappCallUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-border-strong bg-surface/90 px-5 text-sm font-medium text-zinc-200 shadow-sm transition-all hover:border-accent hover:text-white sm:w-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-zinc-400"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span>{siteConfig.hero.secondaryCta}</span>
          </a>
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-4 sm:gap-6 font-mono text-xs text-zinc-300">
          <div class="inline-flex items-center gap-2">
            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span>Entrega em 48h</span>
          </div>

          <div class="inline-flex items-center gap-2">
            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span>Fluxo Assíncrono (Zero Reuniões)</span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="spotlight-card relative mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-border-strong bg-surface p-3.5 sm:p-4 shadow-[0_25px_60px_-15px_rgba(99,102,241,0.3)]">
          <div class="grid grid-cols-2 gap-1.5 rounded-xl border border-border bg-background p-1 font-mono text-[10px] tracking-tight">
            <button
              type="button"
              id="hero-tab-raw"
              class="flex items-center justify-center gap-1.5 rounded-lg px-2 py-2 text-center text-zinc-400 transition-colors hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" class="shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 7l-7 5 7 5V7z" />
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
              </svg>
              <span class="truncate">ARQUIVO BRUTO</span>
            </button>

            <button
              type="button"
              id="hero-tab-kinetic"
              class="flex items-center justify-center gap-1.5 rounded-lg bg-accent px-2 py-2 text-center font-semibold text-white shadow"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" class="shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" />
              </svg>
              <span class="truncate">CORTE KINETIC</span>
            </button>
          </div>
          <div class="relative mt-3.5 aspect-[10/13] w-full overflow-hidden rounded-xl border border-border bg-black">
            <img
              id="hero-preview-img"
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=900&q=80"
              alt="Preview de corte cinético em alta retenção"
              class="h-full w-full object-cover transition-all duration-700"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/95 via-black/25 to-black/30"></div>
            <div class="absolute inset-x-3.5 top-3.5 flex items-center justify-between gap-2 font-mono text-[10px] text-zinc-300">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-black/75 px-2.5 py-1 backdrop-blur-md">
                <span class="size-1.5 shrink-0 rounded-full bg-emerald-400 animate-pulse"></span>
                <span id="hero-status-pill" class="truncate">KINETIC 4K · TIMELAPSE</span>
              </span>
              <span class="shrink-0 rounded-full bg-black/70 px-2.5 py-1 font-mono text-[10px] text-zinc-400">
                00:30
              </span>
            </div>
            <div class="absolute inset-x-3.5 bottom-3.5 flex flex-col gap-3">
              <div class="flex justify-center">
                <span id="hero-hook-caption" class="w-full rounded-xl border border-accent/40 bg-black/85 px-3 py-2 text-center font-display text-xs font-extrabold uppercase leading-snug tracking-wide text-white shadow-lg backdrop-blur-md">
                  "COMO DOBRAR SUA RETENÇÃO NO 1º CORTE"
                </span>
              </div>
              <div class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between gap-2 whitespace-nowrap font-mono text-[10px] sm:text-[11px]">
                  <span class="text-zinc-400">Taxa de Conclusão:</span>
                  <span class="font-bold text-emerald-400">84% (Alta Retenção)</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/15">
                  <div class="h-full w-[84%] rounded-full bg-gradient-to-r from-accent via-accent-purple to-emerald-400 shadow-[0_0_10px_#10B981]"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabRaw = document.getElementById('hero-tab-raw');
  const tabKinetic = document.getElementById('hero-tab-kinetic');
  const previewImg = document.getElementById('hero-preview-img');
  const statusPill = document.getElementById('hero-status-pill');
  const hookCaption = document.getElementById('hero-hook-caption');

  tabRaw?.addEventListener('click', () => {
    tabRaw.className = 'flex items-center justify-center gap-1.5 rounded-lg bg-zinc-700 px-2 py-2 text-center font-semibold text-white shadow';
    if (tabKinetic) {
      tabKinetic.className = 'flex items-center justify-center gap-1.5 rounded-lg px-2 py-2 text-center text-zinc-400 transition-colors hover:text-white';
    }
    if (previewImg) {
      previewImg.style.filter = 'saturate(0.4) contrast(0.8) brightness(1.1)';
    }
    if (statusPill) statusPill.textContent = 'LOG BRUTO DA CÂMERA';
    if (hookCaption) hookCaption.textContent = '[Gravação sem cortes ou legendas]';
  });

  tabKinetic?.addEventListener('click', () => {
    tabKinetic.className = 'flex items-center justify-center gap-1.5 rounded-lg bg-accent px-2 py-2 text-center font-semibold text-white shadow';
    if (tabRaw) {
      tabRaw.className = 'flex items-center justify-center gap-1.5 rounded-lg px-2 py-2 text-center text-zinc-400 transition-colors hover:text-white';
    }
    if (previewImg) {
      previewImg.style.filter = 'none';
    }
    if (statusPill) statusPill.textContent = 'KINETIC 4K · TIMELAPSE';
    if (hookCaption) hookCaption.textContent = '"COMO DOBRAR SUA RETENÇÃO NO 1º CORTE"';
  });
</script>

