---
import { company, navigationLinks } from '../data/niatronConfig';
---

<header class="fixed top-0 inset-x-0 z-50 bg-[#0B101B]/90 backdrop-blur-md border-b border-slate-800/80">
  <div class="max-w-5xl mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#FF5E1E] rounded-lg">
      <div class="w-9 h-9 rounded bg-[#FF5E1E] flex items-center justify-center text-white font-bold text-lg shadow-sm group-hover:bg-[#E04E14] transition-colors">
        N
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-white block leading-none font-display">NIATRON</span>
        <span class="text-[13px] text-slate-400 block mt-0.5 font-normal">Componentes & Sistemas Eletrônicos</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-[15px] font-medium text-slate-300" aria-label="Navegação Principal">
      {navigationLinks.map((link) => (
        <a
          href={link.href}
          class="hover:text-white transition-colors focus:outline-none focus:text-[#FF5E1E]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={`tel:${company.phoneClean}`}
        class="hidden sm:inline text-[14px] font-mono-spec text-slate-300 hover:text-white transition-colors"
      >
        {company.phone}
      </a>
      <a
        href="#contato"
        class="px-4 py-2.5 text-[14px] font-semibold text-white bg-[#FF5E1E] hover:bg-[#E04E14] rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-[#FF5E1E] focus:ring-offset-2 focus:ring-offset-[#0B101B]"
      >
        Solicitar Cotação
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden text-slate-300 hover:text-white p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#FF5E1E]"
        aria-label="Abrir menu de navegação"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-slate-800 bg-[#0F172A] px-6 py-4 space-y-3"
  >
    {navigationLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link block text-base font-medium text-slate-200 hover:text-[#FF5E1E] py-1 transition-colors"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-3 border-t border-slate-800 flex flex-col gap-2">
      <a
        href={`tel:${company.phoneClean}`}
        class="text-sm font-mono-spec text-slate-300"
      >
        Tel: {company.phone}
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
