---
import { siteConfig } from '../data/siteConfig';

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsappNumber}?text=${encodeURIComponent(
  siteConfig.contact.whatsappDefaultMessage
)}`;
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md transition-colors"
>
  <div class="container-vao flex h-20 items-center justify-between">
    <a
      href="#inicio"
      aria-label={`${siteConfig.brand.name} — Ir para o topo`}
      class="group inline-flex items-center gap-2.5 transition-transform duration-300 hover:scale-[1.02]"
    >
      <span
        class="relative flex size-9 items-center justify-center rounded-xl border border-accent/40 bg-gradient-to-br from-accent/20 via-surface to-surface-muted shadow-[0_0_20px_-4px_rgba(99,102,241,0.45)] transition-colors group-hover:border-accent"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 28 28"
          fill="none"
          class="size-5"
          aria-hidden="true"
        >
          <path
            d="M4.5 21V7L10.5 14.5L14 10"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-white"
          />
          <path
            d="M15.5 8.5L23.5 14L15.5 19.5V8.5Z"
            fill="currentColor"
            class="text-accent-light transition-transform duration-300 group-hover:translate-x-0.5"
          />
        </svg>
      </span>
      <span class="font-display text-lg font-extrabold tracking-tight text-zinc-100 sm:text-xl">
        {siteConfig.brand.name}
      </span>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegação da página">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class="group relative py-1 text-sm font-medium tracking-tight text-zinc-400 transition-colors hover:text-zinc-100"
          >
            {item.label}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 -bottom-0.5 h-px origin-center scale-x-0 bg-accent transition-transform duration-300 ease-out group-hover:scale-x-100"
            />
          </a>
        ))
      }
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center gap-2 rounded-xl bg-accent px-5 text-xs font-semibold uppercase tracking-wider text-white shadow-[0_0_20px_-3px_rgba(99,102,241,0.5)] transition-all hover:bg-accent-hover hover:shadow-[0_0_24px_rgba(99,102,241,0.7)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
        </svg>
        <span>Falar no WhatsApp</span>
      </a>
    </div>
    <button
      id="mobile-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu de navegação"
      class="flex size-11 items-center justify-center rounded-xl border border-border bg-surface text-zinc-300 transition-colors hover:border-zinc-500 hover:text-white md:hidden"
    >
      <svg
        id="icon-hamburger"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="block"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
      <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
        aria-hidden="true"
      >
        <line x1="18" x2="6" y1="6" y2="18" />
        <line x1="6" x2="18" y1="6" y2="18" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-b border-border bg-surface/95 px-5 py-6 backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col gap-4">
      <nav class="flex flex-col gap-1 border-border" aria-label="Navegação mobile">
        {
          siteConfig.navigation.map((item) => (
            <a
              href={item.href}
              class="mobile-nav-link rounded-lg px-3 py-2.5 text-base font-medium text-zinc-200 transition-colors hover:bg-surface-muted hover:text-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-accent font-medium text-white shadow-[0_0_20px_-3px_rgba(99,102,241,0.5)]"
      >
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = () => {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    iconHamburger?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  };

  menuBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconHamburger?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

