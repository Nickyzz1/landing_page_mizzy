---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout>
  <main id="conteudo" class="container-vao py-24">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
      {siteConfig.brand.subtitle}
    </p>
    <h1 class="mt-4 font-display text-4xl font-bold text-white">
      {siteConfig.brand.name}
    </h1>
    <p class="mt-2 text-zinc-400">{siteConfig.brand.tagline}</p>
  </main>
</Layout>
